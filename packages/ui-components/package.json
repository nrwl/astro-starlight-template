{
  "name": "@astro-starlight-template/ui-components",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "nx": {
    "projectType": "library",
    "sourceRoot": "packages/ui-components/src",
    "tags": [
      "type:lib",
      "scope:shared"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
